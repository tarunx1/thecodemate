# /etc/thecodemate/env on the server (root:thecodemate, mode 640). Never commit real values.
TC_ENV=production
TC_SITE_URL=https://thecodemate.com
TC_BACKEND_URL=http://127.0.0.1:8020
TC_DATABASE_URL=mysql+pymysql://thecodemate:CHANGE_ME@127.0.0.1/thecodemate?charset=utf8mb4
TC_SECRET_KEY=CHANGE_ME_AT_LEAST_48_RANDOM_CHARACTERS
TC_MEDIA_DIR=/var/www/thecodemate/media
TC_SEO_INDEXING=true
