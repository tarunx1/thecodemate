[Unit]
Description=thecodemate FastAPI backend (private, behind Next.js)
After=network.target mysql.service

[Service]
User=thecodemate
Group=thecodemate
WorkingDirectory=/var/www/thecodemate/current
EnvironmentFile=/etc/thecodemate/env
# One worker: the login rate limiter is in-process.
ExecStart=/var/www/thecodemate/current/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8020 --workers 1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true

[Install]
WantedBy=multi-user.target
