# Use local settings for development only. Never commit actual credentials.
TC_ENV=development
TC_DATABASE_URL=sqlite:///./data/thecodemate.db
TC_SITE_URL=http://127.0.0.1:3000
# Set TC_BACKEND_URL=http://127.0.0.1:8000 for the Next.js process.
TC_SEO_INDEXING=false
# Required for production: long, random secret; cookie HTTPS; a dedicated database.
TC_SECRET_KEY=
# Only for one-time explicit bootstrap, not application runtime:
TC_ADMIN_EMAIL=
TC_ADMIN_PASSWORD=
